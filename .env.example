APP_NAME=SIBAU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Proyek ini dikembangkan di atas MAMP (MySQL). Sesuaikan port bila perlu:
# MAMP standar memakai 8889, XAMPP/Laragon memakai 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=sibau
DB_USERNAME=root
DB_PASSWORD=root

# Kredensial admin awal yang dipakai `php artisan db:seed`.
SIBAU_ADMIN_EMAIL=admin@umi.ac.id
SIBAU_ADMIN_PASSWORD=

# Kata sandi bawaan untuk akun dosen BARU yang dibuat lewat import Excel.
# Akun yang sudah ada tidak pernah diubah oleh import.
# Kosongkan nilainya agar tiap akun baru mendapat kata sandi acak (disarankan
# untuk penggunaan sungguhan).
SIBAU_IMPORT_DEFAULT_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Fitur "Lupa Password" membutuhkan SMTP yang benar-benar berfungsi.
# Selama MAIL_MAILER=log, tautan reset hanya ditulis ke storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sibau@umi.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
